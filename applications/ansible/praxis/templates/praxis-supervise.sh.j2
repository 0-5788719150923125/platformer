#!/bin/bash
# Praxis crash supervisor - deployed by Ansible, invoked by praxis.service.
#
# Sole job: decide whether the next launch should carry --reset, then hand off
# to the real launcher with `exec` so `launch` BECOMES the unit's main process.
# That keeps launch in the foreground process group (docker compose run needs
# this) and wired straight to the journal - exactly like running launch directly.
# Do NOT background launch here: a backgrounded `docker compose run` stalls, and
# a lingering wrapper block-buffers its stdout into the journal pipe (silence).
#
# Crash COUNTING is NOT done here - it lives in the unit's ExecStopPost hook,
# which can tell a real crash from an intentional stop (see praxis.service.j2).
# This script only READS the crash history to make the --reset decision.
#
# Policy: >= THRESHOLD crashes within WINDOW seconds -> next launch gets --reset
# (wipes build artifacts + checkpoints, starts the run from scratch). The history
# is cleared on reset so a single wipe breaks a checkpoint-load loop without
# nuking the fresh run on the next transient blip.
set -uo pipefail

THRESHOLD={{ praxis_reset_threshold | default(3) }}   # X crashes ...
WINDOW={{ praxis_reset_window | default(600) }}        # ... within Y seconds
INSTALL_DIR="{{ praxis_install_dir }}"
STATE_DIR=/var/lib/praxis
HIST="$STATE_DIR/crash-history"     # one unix-timestamp per crash, one per line

mkdir -p "$STATE_DIR"
now=$(date +%s)

# Drop crash timestamps older than the window.
if [ -f "$HIST" ]; then
    awk -v now="$now" -v win="$WINDOW" '($1+0) > (now-win)' "$HIST" > "$HIST.tmp" 2>/dev/null \
        && mv "$HIST.tmp" "$HIST"
fi
count=$(wc -l < "$HIST" 2>/dev/null || echo 0)

reset_args=()
if [ "$count" -ge "$THRESHOLD" ]; then
    echo "[supervise] $count crashes within ${WINDOW}s (>= $THRESHOLD) - relaunching with --reset"
    reset_args=(--reset)
    : > "$HIST"   # clear so the next restart doesn't keep wiping a fresh run
else
    echo "[supervise] $count crashes in the last ${WINDOW}s (threshold $THRESHOLD); launching normally"
fi

# Hand off. exec replaces this shell with launch, so launch is the main process:
# its output flows to the journal and systemd's signals reach it directly.
exec /bin/bash "$INSTALL_DIR/launch" "$@" "${reset_args[@]}"
