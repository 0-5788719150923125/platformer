[Unit]
Description=Praxis AI Agents Framework
After=docker.service
Requires=docker.service
# The crash policy (count crashes, inject --reset) is owned by praxis-supervise.sh,
# not systemd. Disable systemd's own start limiter so it never parks the unit in a
# failed state and stops restarting mid-loop; the wrapper + Restart=always govern it.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=docker
WorkingDirectory={{ praxis_install_dir }}
# Set terminal dimensions for proper UI rendering
Environment="COLUMNS=160"
Environment="LINES=48"
Environment="TERM=xterm-256color"
# Tear down any previous compose containers (handles both bridge and host networking)
ExecStartPre=-/bin/bash -c 'docker compose {{ compose_files }} down --remove-orphans --timeout 10 2>/dev/null; docker ps -q --filter "ancestor=praxis-agent" | xargs -r docker rm -f'
# Launch through the crash supervisor, which decides whether to add --reset.
# Args are passed through verbatim to {{ praxis_install_dir }}/launch.
ExecStart=/bin/bash {{ praxis_install_dir }}/praxis-supervise.sh {{ praxis_launch_args }}
ExecStop=/bin/bash -c 'docker compose {{ compose_files }} down --remove-orphans --timeout 10 2>/dev/null; docker ps -q --filter "ancestor=praxis-agent" | xargs -r docker rm -f'
TimeoutStopSec=30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
