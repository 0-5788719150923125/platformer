# AWS adapter wiring for domains. Not loaded as-is (.tmpl): scripts/providers.sh links
# it into domains/ as adapter_aws.tf in workspaces that set aws_profile, together with
# wiring_override.tf.tmpl. Elsewhere AWS is never loaded.

module "aws" {
  source = "./aws"

  namespace = var.namespace
  config    = var.config
}

# The AWS implementation moved into aws/ (2026-11-25). These blocks carry existing
# state to the new addresses; they travel with the module call.

moved {
  from = aws_acm_certificate.wildcard
  to   = module.aws.aws_acm_certificate.wildcard
}

moved {
  from = aws_route53_record.cert_validation
  to   = module.aws.aws_route53_record.cert_validation
}

moved {
  from = aws_acm_certificate_validation.wildcard
  to   = module.aws.aws_acm_certificate_validation.wildcard
}
