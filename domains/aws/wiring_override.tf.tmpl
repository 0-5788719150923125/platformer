# AWS adapter outputs for domains, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_zone_id         = module.aws.zone_id
  aws_output_zone_name       = module.aws.zone_name
  aws_output_certificate_arn = module.aws.certificate_arn
  aws_output_aliases         = module.aws.aliases
}
