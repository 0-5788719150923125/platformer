# AWS adapter outputs for access, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_iam_role_arns          = module.aws.iam_role_arns
  aws_output_iam_role_names         = module.aws.iam_role_names
  aws_output_instance_profile_names = module.aws.instance_profile_names
  aws_output_instance_profile_arns  = module.aws.instance_profile_arns
  aws_output_bucket_requests        = module.aws.bucket_requests
  aws_output_report_ready           = module.aws.report_ready
  aws_output_artifact_requests      = module.aws.artifact_requests
  aws_output_report_path            = module.aws.report_path
  aws_output_access_summary         = module.aws.access_summary
}
