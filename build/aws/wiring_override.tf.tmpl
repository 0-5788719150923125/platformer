# AWS adapter outputs for build, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_built_amis        = module.aws.built_amis
  aws_output_artifact_requests = module.aws.artifact_requests
  aws_output_access_requests   = module.aws.access_requests
  aws_output_commands          = module.aws.commands
}
