# AWS adapter outputs for secrets, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_replicated_secret_arns     = module.aws.replicated_secret_arns
  aws_output_replicated_parameter_arns  = module.aws.replicated_parameter_arns
  aws_output_replicated_parameter_names = module.aws.replicated_parameter_names
}
