# AWS adapter wiring for secrets. Not loaded as-is (.tmpl): scripts/providers.sh links
# it into secrets/ as adapter_aws.tf in workspaces that set aws_profile, together with
# wiring_override.tf.tmpl. Elsewhere AWS is never loaded.

module "aws" {
  source = "./aws"

  providers = {
    aws                = aws
    aws.infrastructure = aws.infrastructure
    aws.prod           = aws.prod
  }

  namespace      = var.namespace
  aws_account_id = var.aws_account_id
  config         = var.config
}

# The AWS implementation moved into aws/ (2026-11-25). These blocks carry existing
# state to the new addresses; they travel with the module call.

moved {
  from = aws_secretsmanager_secret.replicated
  to   = module.aws.aws_secretsmanager_secret.replicated
}

moved {
  from = aws_secretsmanager_secret_version.replicated
  to   = module.aws.aws_secretsmanager_secret_version.replicated
}

moved {
  from = aws_secretsmanager_secret_policy.account_read
  to   = module.aws.aws_secretsmanager_secret_policy.account_read
}

moved {
  from = aws_ssm_parameter.replicated
  to   = module.aws.aws_ssm_parameter.replicated
}
