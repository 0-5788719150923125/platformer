# AWS adapter outputs for networking, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_vpc                = module.aws.vpc
  aws_output_subnets_by_tier    = module.aws.subnets_by_tier
  aws_output_all_subnets        = module.aws.all_subnets
  aws_output_nat_gateways       = module.aws.nat_gateways
  aws_output_internet_gateway   = module.aws.internet_gateway
  aws_output_route_tables       = module.aws.route_tables
  aws_output_cidr_allocation    = module.aws.cidr_allocation
  aws_output_availability_zones = module.aws.availability_zones
  aws_output_network_summary    = module.aws.network_summary
}
