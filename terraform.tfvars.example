# Example Terraform variables configuration
# Copy this file to terraform.tfvars and customize for your deployment
#
# Workspace overrides: Create terraform.tfvars.{workspace} to override per environment.
# See workspaces/README.md for details.

# AWS Configuration (omit aws_profile for local dev without AWS credentials)
aws_profile = "org-platform-dev"
aws_region  = "us-east-2"
owner       = "Platform"

# Cross-account providers (optional - omit for local dev without cross-account access)
# cross_account_providers = {
#   prod           = { profile = "example-platform-prod" }
#   infrastructure = { profile = "example-infrastructure-prod" }
# }

# ================================
# Service Configuration via Fragments
# ================================
# Load YAML fragments (same ones used by CI) to configure services.
# This is the recommended approach for consistency with CI/CD.
#
# Fragments are stored in fragments/ directory and define service configurations.
# See fragments/README.md for available fragments and their configurations.

# Recommended: Load fragments
fragments = ["configuration-management-hourly"]

# Optional: extra directories to search for fragments, so your configs
# can live outside this repo. Searched in order before fragments/, so on a name
# conflict your copy wins. "~" expands; relative paths resolve against the
# repo root. Every listed directory must exist.
# fragment_paths = ["~/configs/platformer"]

# Alternative Examples:
# fragments = ["configuration-management-monthly", "compute-windows-test"]  # Load multiple fragments
# fragments = []  # No fragments (deploy with defaults)