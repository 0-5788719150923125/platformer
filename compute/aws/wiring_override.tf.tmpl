# AWS adapter outputs for compute, linked in as adapter_aws_override.tf by
# scripts/providers.sh together with wiring.tf.tmpl (see ../adapters.tf).

locals {
  aws_wired = true

  aws_output_instances                    = module.aws.instances
  aws_output_instance_keys                = module.aws.instance_keys
  aws_output_service_instance_keys        = module.aws.service_instance_keys
  aws_output_config                       = module.aws.config
  aws_output_instances_by_tenant          = module.aws.instances_by_tenant
  aws_output_instances_by_class           = module.aws.instances_by_class
  aws_output_eks_clusters                 = module.aws.eks_clusters
  aws_output_eks_cluster_security_groups  = module.aws.eks_cluster_security_groups
  aws_output_eks_node_groups              = module.aws.eks_node_groups
  aws_output_eks_test_commands            = module.aws.eks_test_commands
  aws_output_application_requests         = module.aws.application_requests
  aws_output_cluster_application_requests = module.aws.cluster_application_requests
  aws_output_instance_role_arn            = module.aws.instance_role_arn
  aws_output_instance_role_name           = module.aws.instance_role_name
  aws_output_eks_node_role_name           = module.aws.eks_node_role_name
  aws_output_alb_dns_names                = module.aws.alb_dns_names
  aws_output_http_dns_names               = module.aws.http_dns_names
  aws_output_alias_fqdn_by_class          = module.aws.alias_fqdn_by_class
  aws_output_lb_dns_names                 = module.aws.lb_dns_names
  aws_output_helm_releases                = module.aws.helm_releases
  aws_output_commands                     = module.aws.commands
  aws_output_kubeconfig_ready             = module.aws.kubeconfig_ready
  aws_output_ecs_clusters                 = module.aws.ecs_clusters
  aws_output_volume_requests              = module.aws.volume_requests
  aws_output_access_requests              = module.aws.access_requests
  aws_output_access_security_groups       = module.aws.access_security_groups
  aws_output_ecs_test_commands            = module.aws.ecs_test_commands
}
